# Copy this file to .env and enter your own local PostgreSQL credentials.
PORT=5000
NODE_ENV=development

# Use DATABASE_URL OR the individual PG* settings below.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/aurastore
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD
PGDATABASE=aurastore

# Generate a unique secret:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=30d
